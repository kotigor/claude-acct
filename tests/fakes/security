#!/usr/bin/env bash
# Fake macOS `security` backed by files in $FAKE_KEYCHAIN_DIR. Mimics what
# claude-acct depends on: exit 44 for a missing item, hex output for data that
# is not printable ASCII, and `-i` mode choking on lines longer than 4096 bytes.
# FAKE_SECURITY_IGNORE_WRITES_FOR=<service> silently drops writes to that service.
set -euo pipefail

printf 'security %s\n' "$*" >>"${FAKE_LOG:-/dev/null}"
dir=${FAKE_KEYCHAIN_DIR:?FAKE_KEYCHAIN_DIR is not set}

item_path() {
  printf '%s/%s__%s' "$dir" "$(printf '%s' "$1" | xxd -p | tr -d '\n')" "$(printf '%s' "$2" | xxd -p | tr -d '\n')"
}

run() {
  local cmd=$1 acct="" svc="" data="" have_data=0 update=0 print=0 path
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -a) acct=$2; shift 2 ;;
      -s) svc=$2; shift 2 ;;
      -U) update=1; shift ;;
      -X) data=$(printf '%s' "$2" | xxd -r -p); have_data=1; shift 2 ;;
      -w)
        if [ "$cmd" = find-generic-password ]; then print=1; shift
        else data=$2; have_data=1; shift 2; fi ;;
      *) echo "fake security: unsupported option $1" >&2; return 2 ;;
    esac
  done
  path=$(item_path "$svc" "$acct")
  case "$cmd" in
    find-generic-password)
      if [ ! -f "$path" ]; then
        echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
        return 44
      fi
      if [ "$print" = 0 ]; then echo 'keychain: "fake"'
      elif LC_ALL=C grep -q '[^ -~]' "$path"; then xxd -p "$path" | tr -d '\n'; echo
      else cat "$path"; echo; fi ;;
    add-generic-password)
      [ "$have_data" = 1 ] || { echo "fake security: no data" >&2; return 2; }
      if [ -f "$path" ] && [ "$update" = 0 ]; then
        echo "security: The specified item already exists in the keychain." >&2
        return 45
      fi
      [ "${FAKE_SECURITY_IGNORE_WRITES_FOR:-}" = "$svc" ] && return 0
      printf '%s' "$data" >"$path" ;;
    delete-generic-password)
      [ -f "$path" ] || { echo "security: The specified item could not be found in the keychain." >&2; return 44; }
      rm -f "$path" ;;
    *) echo "fake security: unsupported command $cmd" >&2; return 2 ;;
  esac
}

if [ "${1:-}" = -i ]; then
  status=0
  while IFS= read -r line || [ -n "$line" ]; do
    [ "${#line}" -le 4096 ] || line=${line:0:4096}
    eval "set -- $line"
    run "$@" || status=$?
  done
  exit "$status"
fi
run "$@"
